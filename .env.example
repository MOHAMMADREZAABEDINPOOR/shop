# Django Core Settings
SECRET_KEY=your-secret-key-here-min-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Field-level encryption key for sensitive PII (generate with Fernet, keep secret!)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Database (Leave empty for local SQLite, or provide postgres://user:password@localhost:5432/dbname)
DATABASE_URL=

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Shop Support <noreply@example.com>

# Payment Gateway Configuration
PAYMENT_GATEWAY_DEFAULT=sandbox
PAYMENT_PUBLIC_KEY=sandbox-public-key
PAYMENT_SECRET=sandbox-secret-key
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True

# Cache & Redis (Optional)
REDIS_URL=redis://127.0.0.1:6379/1

# Analytics & Integrations (Optional)
ANALYTICS_ID=
